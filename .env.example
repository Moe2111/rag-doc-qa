# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# Anthropic — answer generation (console.anthropic.com)
ANTHROPIC_API_KEY=

# Voyage AI — embeddings, voyage-3-lite / 512 dimensions (voyageai.com)
VOYAGE_API_KEY=

# Pinecone — vector store (pinecone.io)
# The index must be dense, 512 dimensions, cosine metric.
PINECONE_API_KEY=
PINECONE_INDEX=

# AWS — original file storage. Use an IAM user scoped to this bucket, not root keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
